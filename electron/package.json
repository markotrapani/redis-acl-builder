{
  "name": "redis-acl-builder",
  "productName": "Redis ACL Builder",
  "version": "2.1.7-beta",
  "description": "Redis ACL Builder - Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "unset ELECTRON_RUN_AS_NODE && electron .",
    "start:devtools": "unset ELECTRON_RUN_AS_NODE && ELECTRON_DEVTOOLS=true electron .",
    "dev": "unset ELECTRON_RUN_AS_NODE && electron . --dev",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:mac:universal": "electron-builder --mac --universal",
    "build:mac:all": "electron-builder --mac --arm64 --x64 --universal",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "redis",
    "acl",
    "electron",
    "desktop"
  ],
  "author": {
    "name": "Marko Trapani",
    "email": "marko.trapani@redis.com"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/markotrapani/redis-acl-builder.git"
  },
  "devDependencies": {
    "electron": "^27.3.11",
    "electron-builder": "^24.13.3",
    "@electron/notarize": "^2.1.0"
  },
  "dependencies": {
    "electron-is-dev": "^3.0.1",
    "electron-updater": "^6.1.4"
  },
  "build": {
    "appId": "com.redis.acl-builder",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "markotrapani",
      "repo": "redis-acl-builder"
    },
    "files": [
      "main.js",
      "preload.js",
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist/redis-acl-builder-backend",
        "to": "dist/redis-acl-builder-backend",
        "filter": ["**/*"]
      }
    ],
    "asarUnpack": [
      "**/dist/redis-acl-builder-backend/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "contents": [
        {
          "x": 165,
          "y": 200
        },
        {
          "x": 495,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 660,
        "height": 420
      },
      "iconSize": 120,
      "background": "build/background-light.png"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}
