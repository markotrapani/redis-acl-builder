{
  "name": "redis-acl-builder-desktop",
  "version": "2.0.3-alpha",
  "description": "Redis ACL Builder - Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "unset ELECTRON_RUN_AS_NODE && electron .",
    "start:devtools": "unset ELECTRON_RUN_AS_NODE && ELECTRON_DEVTOOLS=true electron .",
    "dev": "unset ELECTRON_RUN_AS_NODE && electron . --dev",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:mac:universal": "electron-builder --mac --universal",
    "build:mac:all": "electron-builder --mac --arm64 --x64 --universal",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "redis",
    "acl",
    "electron",
    "desktop"
  ],
  "author": "Marko Trapani",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/markotrapani/marko-projects.git",
    "directory": "redis-acl-builder"
  },
  "devDependencies": {
    "electron": "^27.3.11",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-is-dev": "^3.0.1"
  },
  "build": {
    "appId": "com.redis.acl-builder",
    "productName": "Redis ACL Builder",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist/redis-acl-builder-backend",
        "to": "dist/redis-acl-builder-backend",
        "filter": ["**/*"]
      }
    ],
    "asarUnpack": [
      "**/dist/redis-acl-builder-backend/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "contents": [
        {
          "x": 165,
          "y": 200
        },
        {
          "x": 495,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 660,
        "height": 420
      },
      "iconSize": 120,
      "background": "build/background-light.png"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}
